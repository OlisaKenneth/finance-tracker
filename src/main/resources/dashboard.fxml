<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>

<VBox spacing="10" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.financetracker.DashboardController"
      style="-fx-padding: 20;">

    <Label text="Finance Tracker" style="-fx-font-size: 24;"/>
    <Button text="Add Expense" fx:id="addExpenseBtn" onAction="#handleAddExpense"/>
    <Button text="View Budgets" fx:id="viewBudgetsBtn" onAction="#handleViewBudgets"/>
    <Button text="Add Savings" fx:id="addSavingsBtn" onAction="#handleAddSavings"/>
    <Button text="View Goals" fx:id="viewGoalsBtn" onAction="#handleViewGoals"/>
    <Button text="View Transactions" fx:id="viewTransactionsBtn" onAction="#handleViewTransactions"/>
</VBox>